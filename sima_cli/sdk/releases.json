{
  "schema_version": 1,
  "model_compiler": {
    "architectures": {
      "amd64": {
        "machines": [
          "x86_64",
          "amd64",
          "i386",
          "i686",
          "x86"
        ],
        "sdk_versions": ">=0"
      },
      "arm64": {
        "machines": [
          "aarch64",
          "arm64"
        ],
        "sdk_versions": ">=2.1.1"
      }
    },
    "releases": [
      {
        "sdk_versions": "==3.0.0.0",
        "install_args": [
          "neat",
          "install",
          "model-compiler/{arch}@v3.0.0"
        ],
        "bundle_sdk_version": "3.0.0"
      },
      {
        "sdk_versions": "==3.0.0.1",
        "install_args": [
          "neat",
          "install",
          "model-compiler/{arch}@v3.0.0.1"
        ],
        "bundle_sdk_version": "3.0.0.1"
      },
      {
        "sdk_versions": ">=2.1.3",
        "install_args": [
          "neat",
          "install",
          "model-compiler/{arch}@v2.1.3.1"
        ],
        "bundle_sdk_version": "2.1.3"
      },
      {
        "sdk_versions": "<2.1.3",
        "install_args": [
          "install",
          "-v",
          "{legacy_sdk_version}",
          "tools/model-compiler/{arch}"
        ],
        "bundle_sdk_version": "{legacy_sdk_version}"
      }
    ]
  }
}
